    "next": "^16.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "resend": "^6.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.9.0",
    "eslint-config-next": "^16.3.1",
    "lefthook": "^2.1.10",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
