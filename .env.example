# Copy to .env.local. NEVER commit real values (gitleaks will block them).
# Point at a Sydney-region Supabase project with asymmetric JWT signing keys enabled,
# so getClaims() verifies locally instead of calling the auth server on every navigation.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses row-level security — never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional
SENTRY_DSN=

# Test role profiles (optional). `npm run seed:roles` provisions one login per
# role using the two Supabase variables above; these only change its defaults.
# See CLAUDE.md §3a. Flags win over the environment: --tenant/--domain/--password.
# ROLE_PROFILE_TENANT=Harbour Commercial Laundry
# ROLE_PROFILE_EMAIL_DOMAIN=roles.example.com
# ROLE_PROFILE_PASSWORD=

# Email delivery, via Resend (optional). One sender for everything the app
# posts: invoices, customer notices, and — since 2026-08-24 — invitations and
# sign-in links, which used to go through Supabase's own mailer and so needed
# custom SMTP. Without these the app runs normally and each of those actions
# says plainly that no provider is configured.
#
# The names still say INVOICE_ because renaming them would take a live
# deployment's mail down at the moment it was redeployed; they are the app's
# from-address for all of it.
# INVOICE_FROM_EMAIL must be on a domain verified in Resend, or sends bounce.
#
# Turning this on for real, in order:
#   1. Add the sending domain in Resend and complete its DNS records — SPF and
#      DKIM at least. Until the domain shows "verified", sends are accepted by
#      the API and land in spam or bounce, which looks like the app failing.
#   2. Set all four below on the Vercel project (Production *and* Preview, or
#      preview deployments silently send nothing).
#   3. Sign in as an owner and press Settings > Notifications > "Send a test
#      email". It goes only to your own address and is audited. Do that before
#      switching any customer email on.
#
# INVOICE_FROM_NAME is what a customer sees as the sender. Use the laundry's
# own name, not the app's and not Core IT's — an invoice comes from the
# business, and the Core IT credit is a line in the footer, not the sender.
RESEND_API_KEY=
INVOICE_FROM_EMAIL=accounts@YOUR_DOMAIN.com.au
INVOICE_FROM_NAME=
INVOICE_REPLY_TO=

# Notification sweep (optional). Vercel Cron sends this as
# `Authorization: Bearer $CRON_SECRET`; set the same value here and in the
# Vercel project. Without it /api/notifications/sweep refuses every request,
# so the swept notifications (invoice overdue, run not started) never fire.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Xero (optional). Create a Custom Connection / Web App at
# https://developer.xero.com and add <origin>/api/xero/callback as a redirect
# URI. Without these the Money → Xero screen says Xero is not configured and
# nothing else changes. The redirect URI is derived from the request origin, so
# a preview deployment connects to itself.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
